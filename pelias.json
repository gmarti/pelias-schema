{
  "logger": {
    "level": "info",
    "timestamp": false
  },
  "esclient": {
    "apiVersion": "7.x",
    "requestTimeout": "1200000",
    "hosts": [
      {
        "protocol": "http",
        "host": "${ES_HOSTNAME}",
        "port": 80
      }
    ]
  },
  "elasticsearch": {
    "settings": {
      "index": {
        "codec": "best_compression",
        "refresh_interval": "-1",
        "number_of_replicas": "0",
        "number_of_shards": "12"
      }
    }
  }
}